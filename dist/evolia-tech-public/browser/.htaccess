# ----------------------------------------------------------------------
# REDIRECTION SPÉCIFIQUE POUR LE WEBMAIL
# ----------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTP_HOST} ^mail\.evolia-tech\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.mail\.evolia-tech\.com$ [NC]
RewriteRule ^(.*)$ https://evolia-tech.com:2096 [L,R=301]
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# CONFIGURATION POUR PROJET ANGULAR (Gestion du Refresh / 404)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Si le domaine demandé est evolia-tech.com ou www.evolia-tech.com
  RewriteCond %{HTTP_HOST} ^(www\.)?evolia-tech\.com$ [NC]
  
  # Et si le fichier ou le dossier demandé n'existe pas physiquement
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Alors on redirige en interne vers l'index.html d'Angular (sans changer l'URL du navigateur)
  RewriteRule ^ index.html [L]
</IfModule>
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# EXPIRES CACHING (Optimisation Cache Navigateur pour Lighthouse & o2switch)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images (1 an)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Polices (1 an)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # Fichiers compilés JS et CSS (1 an car hashés par Angular)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Autoriser la mise en cache publique pour la performance
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|woff|woff2|svg)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
# ----------------------------------------------------------------------